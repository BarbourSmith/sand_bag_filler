          "interpreterVersion": 1,
          "code": "function run(\n  BodyWidth: number = 220,\n  TotalLength: number = 320,\n  InsertionClearance: number = 50,\n  HandleLength: number = 120,\n  SideProjection: number = 50,\n  CornerRadius: number = 10\n): Assembly {\n  const b = BodyWidth/2, r = CornerRadius, k = Math.SQRT1_2;\n  const bottom = -TotalLength/2, crown = TotalLength/2-b;\n  const low = bottom+InsertionClearance+r, high = low+HandleLength;\n  const edge = b+SideProjection;\n  if (high+r >= crown || SideProjection < 2*r || BodyWidth <= 2*r) {\n    throw new Error(\"Increase length or reduce handle size so the rounded shoulders fit below the crown.\");\n  }\n  const outline = replicad.draw([-b+r,bottom])\n    .lineTo([b-r,bottom])\n    .threePointsArcTo([b,bottom+r],[b-r+r*k,bottom+r-r*k])\n    .lineTo([b,low-r])\n    .threePointsArcTo([b+r,low],[b+r-r*k,low-r+r*k])\n    .lineTo([edge-r,low])\n    .threePointsArcTo([edge,low+r],[edge-r+r*k,low+r-r*k])\n    .lineTo([edge,high-r])\n    .threePointsArcTo([edge-r,high],[edge-r+r*k,high-r+r*k])\n    .lineTo([b+r,high])\n    .threePointsArcTo([b,high+r],[b+r-r*k,high+r-r*k])\n    .lineTo([b,crown])\n    .threePointsArcTo([-b,crown],[0,crown+b])\n    .lineTo([-b,high+r])\n    .threePointsArcTo([-b-r,high],[-b-r+r*k,high+r-r*k])\n    .lineTo([-edge+r,high])\n    .threePointsArcTo([-edge,high-r],[-edge+r-r*k,high-r+r*k])\n    .lineTo([-edge,low+r])\n    .threePointsArcTo([-edge+r,low],[-edge+r-r*k,low+r-r*k])\n    .lineTo([-b-r,low])\n    .threePointsArcTo([-b,low-r],[-b-r+r*k,low-r+r*k])\n    .lineTo([-b,bottom+r])\n    .threePointsArcTo([-b+r,bottom],[-b+r-r*k,bottom+r-r*k])\n    .close();\n  return new Assembly({geometry:outline,color:\"#aad7f2\"});\n}",
          "compiledCode": "\"use strict\";\nfunction run(BodyWidth = 220, TotalLength = 320, InsertionClearance = 50, HandleLength = 120, SideProjection = 50, CornerRadius = 10) {\n    const b = BodyWidth / 2, r = CornerRadius, k = Math.SQRT1_2;\n    const bottom = -TotalLength / 2, crown = TotalLength / 2 - b;\n    const low = bottom + InsertionClearance + r, high = low + HandleLength;\n    const edge = b + SideProjection;\n    if (high + r >= crown || SideProjection < 2 * r || BodyWidth <= 2 * r) {\n        throw new Error(\"Increase length or reduce handle size so the rounded shoulders fit below the crown.\");\n    }\n    const outline = replicad.draw([-b + r, bottom])\n        .lineTo([b - r, bottom])\n        .threePointsArcTo([b, bottom + r], [b - r + r * k, bottom + r - r * k])\n        .lineTo([b, low - r])\n        .threePointsArcTo([b + r, low], [b + r - r * k, low - r + r * k])\n        .lineTo([edge - r, low])\n        .threePointsArcTo([edge, low + r], [edge - r + r * k, low + r - r * k])\n        .lineTo([edge, high - r])\n        .threePointsArcTo([edge - r, high], [edge - r + r * k, high - r + r * k])\n        .lineTo([b + r, high])\n        .threePointsArcTo([b, high + r], [b + r - r * k, high + r - r * k])\n        .lineTo([b, crown])\n        .threePointsArcTo([-b, crown], [0, crown + b])\n        .lineTo([-b, high + r])\n        .threePointsArcTo([-b - r, high], [-b - r + r * k, high + r - r * k])\n        .lineTo([-edge + r, high])\n        .threePointsArcTo([-edge, high - r], [-edge + r - r * k, high - r + r * k])\n        .lineTo([-edge, low + r])\n        .threePointsArcTo([-edge + r, low], [-edge + r - r * k, low + r - r * k])\n        .lineTo([-b - r, low])\n        .threePointsArcTo([-b, low - r], [-b - r + r * k, low - r + r * k])\n        .lineTo([-b, bottom + r])\n        .threePointsArcTo([-b + r, bottom], [-b + r - r * k, bottom + r - r * k])\n        .close();\n    return new Assembly({ geometry: outline, color: \"#aad7f2\" });\n}\n"
        },
